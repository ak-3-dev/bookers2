<div class="container mt-5">
  <div class="row">
    <div class="col-sm-12 col-md-8 col-lg-5 px-5 px-sm-0 mx-auto">
      <h2>Log in</h2>

      <% if flash[:alert] %>
        <div class="text-danger mb-3"><%= flash[:alert] %></div>
      <% end %>
      <% if flash[:notice] %>
        <div class="text-success mb-3"><%= flash[:notice] %></div>
      <% end %>

      <%= form_with url: session_path do |form| %>
        <div class="form-group">
          <%= form.label :name, "Name" %>
          <%= form.text_field :name, required: true, autofocus: true, class: "form-control" %>
        </div>

        <div class="form-group">
          <%= form.label :password, "Password" %>
          <%= form.password_field :password, required: true, class: "form-control" %>
        </div>

        <div class="actions mt-3">
          <%= form.submit "Log in", class: "btn btn-primary" %>
        </div>
      <% end %>

      <div class="mt-3">
        <%= link_to "新規登録はこちら", new_user_path %>
      </div>
    </div>
  </div>
</div>