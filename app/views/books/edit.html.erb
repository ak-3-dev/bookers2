<div class="container">
  <div class="row">
    <div class="col-sm-12 col-md-8 col-lg-5 px-sm-0 mx-auto">
      <h1 class="display-5 mt-3 mb-3"><strong>Editing Book</strong></h1>

      <% if @book.errors.any? %>
        <div id="error_explanation">
         <h3><%= @book.errors.count %> errors prohibited this book from being saved:</h3>
         <ul>
           <% @book.errors.full_messages.each do |message| %>
             <li><%= message %></li>
           <% end %>
         </ul>
        </div>
      <% end %>

      <%=form_with model: @book do |f| %>
        <div class="form-group">
          <label for="book_title" class="mb-2">Title</label>
          <%= f.text_field :title, class: "form-control" %>
        </div>
        <div class="form_group">
          <label for="book_body" class="mt-3 mb-2 ">Opinion</label>
          <%= f.text_area :body, class: "form-control" %>
        </div>
        <div class="form-group mt-3 mb-3">
          <%= f.submit "Update Book", class: "btn btn-success" %>
        </div>
      <% end %>

      <%= link_to "Show", book_path(@book) %> | <%= link_to "Back", books_path %>
    </div>
  </div>
</div>